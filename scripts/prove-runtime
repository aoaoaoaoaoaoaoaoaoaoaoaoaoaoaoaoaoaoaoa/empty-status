#!/bin/sh
set -eu

root=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
cell=$(mktemp -d "${TMPDIR:-/tmp}/empty-status-lifecycle.XXXXXX")
pid=
cleanup() {
    if [ -n "$pid" ]; then
        kill "$pid" 2>/dev/null || true
        wait "$pid" 2>/dev/null || true
    fi
    rm -rf -- "$cell"
}
trap cleanup EXIT HUP INT TERM
cd "$root"

cargo install --locked --force --path . --root "$cell/prefix"
binary=$cell/prefix/bin/empty-status
companion=$cell/prefix/bin/empty-status-claude-statusline
test -x "$binary"
test -x "$companion"

mkdir -p "$cell/home" "$cell/config" "$cell/state"
printf '%s\n' '{}' >"$cell/claude-statusline.json"
HOME=$cell/home \
XDG_CONFIG_HOME=$cell/config \
XDG_STATE_HOME=$cell/state \
    "$companion" <"$cell/claude-statusline.json" >"$cell/claude-statusline.out"
HOME=$cell/home \
XDG_CONFIG_HOME=$cell/config \
XDG_STATE_HOME=$cell/state \
    "$binary" </dev/null >"$cell/i3bar.out" 2>"$cell/i3bar.err" &
pid=$!
ready=false
for _attempt in $(seq 1 100); do
    if grep -Fq '{"version":1,"click_events":true}' "$cell/i3bar.out"; then
        ready=true
        break
    fi
    kill -0 "$pid" 2>/dev/null || {
        cat "$cell/i3bar.err" >&2
        exit 1
    }
    sleep 0.05
done
[ "$ready" = true ]
kill "$pid"
wait "$pid" 2>/dev/null || true
pid=
test -f "$cell/config/empty-status/config.toml"

mkdir -p "$cell/state/empty-status"
printf '%s\n' preserved >"$cell/state/empty-status/uninstall-sentinel"
cargo uninstall --root "$cell/prefix" empty-status
test ! -e "$binary"
test ! -e "$companion"
test -f "$cell/state/empty-status/uninstall-sentinel"
